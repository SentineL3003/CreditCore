<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="199.0" prefWidth="433.0" spacing="12.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.creditcore.ChangeRequestStatusController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>

        <Label styleClass="title-label" text="Изменить статус заявки">
            <font>
                <Font name="JetBrains Mono Regular" size="24.0" />
            </font>
        </Label>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" minWidth="140.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="28.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="28.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label styleClass="field-label" text="Заявка">
                    <font>
                        <Font name="JetBrains Mono Regular" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="requestField" GridPane.columnIndex="1" />

                <Label styleClass="field-label" text="Статус" GridPane.rowIndex="1">
                    <font>
                        <Font name="JetBrains Mono Regular" size="12.0" />
                    </font>
                </Label>
                <ChoiceBox fx:id="statusChoiceBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>

        <Region prefHeight="2.0" prefWidth="460.0" VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <children>
                <Button fx:id="cancelButton" onAction="#onCancel" prefHeight="35.0" prefWidth="100.0" styleClass="secondary-button" text="Отмена">
                    <font>
                        <Font name="JetBrains Mono Regular" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="saveButton" defaultButton="true" onAction="#onSave" prefHeight="35.0" prefWidth="100.0" styleClass="primary-button" text="Сохранить">
                    <font>
                        <Font name="JetBrains Mono Regular" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>

    </children>
</VBox>
