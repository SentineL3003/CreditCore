<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="860.0" spacing="8.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.creditcore.SpecialistController">
    <children>
        <HBox alignment="BOTTOM_CENTER" prefHeight="36.0" prefWidth="860.0" spacing="10.0">
            <padding>
                <Insets left="12.0" right="12.0" />
            </padding>
            <children>
                <Label prefHeight="32.0" prefWidth="312.0" text="Кредитная организация">
                    <font>
                        <Font name="JetBrains Mono Regular" size="24.0" />
                    </font>
                </Label>
                <Region prefHeight="51.0" prefWidth="276.0" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#exit" prefWidth="100.0" text="Выход" />
            </children>
        </HBox>

        <TabPane prefWidth="860.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Клиенты">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="clientSearchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="clientSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="idColumn" text="№" />
                                        <TableColumn fx:id="fioColumn" text="ФИО" />
                                        <TableColumn fx:id="passportColumn" text="Паспорт" />
                                        <TableColumn fx:id="contactColumn" text="Контакты" />
                                        <TableColumn fx:id="dateColumn" text="Дата регистрации" />
                                        <TableColumn fx:id="ratingColumn" text="Рейтинг" />
                                        <TableColumn fx:id="statusColumn" text="Статус" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Поручители">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="guarSearchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="guarSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="guarantorsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="guarIdColumn" prefWidth="33.0" text="№" />
                                        <TableColumn fx:id="guarFioColumn" prefWidth="127.0" text="ФИО" />
                                        <TableColumn fx:id="guarPassportColumn" text="Паспорт" />
                                        <TableColumn fx:id="guarContactColumn" text="Контакты" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Клиенты/Поручители">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="cliGuarSearchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="cliGuarSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="cliGuarantorsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="cliGuarIdCColumn" prefWidth="33.0" text="Клиент" />
                                        <TableColumn fx:id="cliGuarIDGColumn" prefWidth="127.0" text="Поручитель" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Заявки">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="reqSearchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="reqSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="reqIdColumn" text="№" />
                                        <TableColumn fx:id="reqDateColumn" text="Дата подачи" />
                                        <TableColumn fx:id="reqClientColumn" text="Клиент" />
                                        <TableColumn fx:id="reqEmployeeColumn" text="Сотрудник" />
                                        <TableColumn fx:id="reqAmountColumn" text="Сумма" />
                                        <TableColumn fx:id="reqTermColumn" text="Срок" />
                                        <TableColumn fx:id="reqPurposeColumn" text="Цель" />
                                        <TableColumn fx:id="reqStatusColumn" text="Статус" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Кредитные договоры">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="contSearchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="contSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="contractsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="contIdColumn" text="№" />
                                        <TableColumn fx:id="contBeginDateColumn" text="Дата заключения" />
                                        <TableColumn fx:id="contRequestIdColumn" text="№ Заявки" />
                                        <TableColumn fx:id="contAmountColumn" text="Сумма выдачи" />
                                        <TableColumn fx:id="contPercentColumn" text="Процентная ставка" />
                                        <TableColumn fx:id="contRepaymentScheduleColumn" text="Схема погашения" />
                                        <TableColumn fx:id="contEndDateColumnColumn" text="Дата окончания" />
                                        <TableColumn fx:id="contStatusColumnColumn" text="Статус" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

        <HBox alignment="CENTER" prefWidth="860.0" spacing="8.0">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="5.0" />
            </padding>
            <children>
                <Button fx:id="addClientButton" onAction="#openAddClient" prefHeight="30.0" prefWidth="116.0" text="Добавить клиента" />
                <Button fx:id="deleteClientButton" onAction="#deleteClient" prefHeight="30.0" text="Удалить клиента" />
                <Button fx:id="addGuarantorButton" onAction="#openAddGuarantor" prefHeight="30.0" text="Добавить поручителя" />
                <Button onAction="#deleteGuarantor" prefHeight="30.0" text="Удалить поручителя" />
                <Button fx:id="addRequestButton" onAction="#openAddRequest" prefHeight="30.0" text="Подать заявку" />
                <Button fx:id="addContractButton" onAction="#openAddContract" prefHeight="30.0" text="Зарегистрировать договор" />
            </children>
        </HBox>
    </children>
</VBox>
