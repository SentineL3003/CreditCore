<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="860.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.creditcore.OperatorController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="47.0" prefWidth="860.0" spacing="10.0">
            <padding>
                <Insets left="12.0" right="12.0" />
            </padding>
            <children>
                <Label prefHeight="32.0" prefWidth="373.0" text="Кредитная организация">
                    <font>
                        <Font name="JetBrains Mono Regular" size="24.0" />
                    </font>
                </Label>
                <Region prefHeight="51.0" prefWidth="248.0" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#exit" prefWidth="100.0" text="Выход" />
            </children>
        </HBox>
        <TabPane prefHeight="626.0" prefWidth="860.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Клиенты">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="searchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="clientSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="clientsTable" prefHeight="523.0" prefWidth="840.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="idColumn" text="№" />
                                        <TableColumn fx:id="fioColumn" text="ФИО" />
                                        <TableColumn fx:id="passportColumn" text="Паспорт" />
                                        <TableColumn fx:id="contactColumn" text="Контакты" />
                                        <TableColumn fx:id="dateColumn" text="Дата регистрации" />
                                        <TableColumn fx:id="ratingColumn" text="Рейтинг" />
                                        <TableColumn fx:id="statusColumn" text="Статус" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Кредитные договоры">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="contSearchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="contClientSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="contractsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="contIdColumn" text="№" />
                                        <TableColumn fx:id="contBeginDateColumn" text="Дата заключения" />
                                        <TableColumn fx:id="contRequestIdColumn" text="№ Заявки" />
                                        <TableColumn fx:id="contAmountColumn" text="Сумма выдачи" />
                                        <TableColumn fx:id="contPercentColumn" text="Процентная ставка" />
                                        <TableColumn fx:id="contRepaymentScheduleColumn" text="Схема погашения" />
                                        <TableColumn fx:id="contEndDateColumnColumn" text="Дата окончания" />
                                        <TableColumn fx:id="contStatusColumnColumn" text="Статус" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="График платежей">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="grafSearchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="grafClientSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="graficTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="grafIdPaymentColumn" prefWidth="33.0" text="№ Платежа" />
                                        <TableColumn fx:id="grafIdContractColumn" prefWidth="127.0" text="№ Договора" />
                                        <TableColumn fx:id="grafDatePlanColumn" text="Дата плановая" />
                                        <TableColumn fx:id="grafAmounPlanColumn" text="Сумма плановая" />
                                        <TableColumn fx:id="grafDateFactColumn" text="Дата фактическая" />
                                        <TableColumn fx:id="grafAmounFactColumn" text="Сумма фактическая" />
                                        <TableColumn fx:id="grafPenaltiesColumn" text="Пени" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Поступления">
                    <content>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets topRightBottomLeft="10.0" />
                            </padding>
                            <children>
                                <HBox spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="recSearchBy" prefWidth="124.0" promptText="Искать по" />
                                        <TextField fx:id="recClientSearch" prefWidth="178.0" promptText="Поиск" />
                                    </children>
                                </HBox>
                                <TableView fx:id="receiptsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="recIdReceiptsColumn" text="№ Поступления" />
                                        <TableColumn fx:id="recIdPaymentColumn" text="№ Платежа" />
                                        <TableColumn fx:id="reqDateColumn" text="Дата" />
                                        <TableColumn fx:id="reqAmountColumn" text="Сумма" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <HBox alignment="CENTER" prefHeight="59.0" prefWidth="860.0" spacing="8.0">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="5.0" />
            </padding>
            <children>
                <Button fx:id="addClientButton"  prefHeight="30.0" prefWidth="150.0" text="Заполнить платёж" />
                <Button fx:id="deleteClientButton" prefHeight="30.0" text="Добавить поступление" />
                <Button fx:id="addGuarantorButton"  prefHeight="30.0" text="Закрыть договор" />
            </children>
        </HBox>
    </children>
</VBox>
